{
  "schema": "rig.pack.v1",
  "name": "rig-prime-fleet",
  "version": "1.0.0",
  "description": "Every agent, harness and skill from the four packs plus the meta-agents and runnable meta-skills of the full fleet.",
  "includes": [
    "rig-engineering-pack",
    "rig-content-pack",
    "rig-design-pack",
    "rig-gtm-pack"
  ],
  "contract": {
    "runtime": "plugin runtime (context held in the runtime kernel, not the prompt)",
    "doctrine": "rig-prime-fleet",
    "provides": {
      "agents": 122,
      "harnesses": 32,
      "skills": 23
    },
    "agent_sections": [
      "## Operating contract",
      "## Plugin contract (prime)"
    ]
  },
  "permissions": {
    "commands": [
      "{python}"
    ],
    "env": [],
    "writes_pack": false
  },
  "done_tests": [
    {
      "id": "agents-contract",
      "description": "Every agent has frontmatter (name matches file, non-empty description) and the Operating contract and Plugin contract sections.",
      "run": [
        "{python}",
        "-m",
        "rigmarket.checks",
        "agents",
        "{pack}/agents",
        "--expect",
        "122",
        "--section",
        "## Operating contract",
        "--section",
        "## Plugin contract (prime)"
      ],
      "expect_stdout_contains": [
        "\"status\": \"PASS\""
      ]
    },
    {
      "id": "harnesses-wellformed",
      "description": "Every harness parses, its id matches the file name, every gate has a requirement and a proof, and the failure protocol names only declared gates.",
      "run": [
        "{python}",
        "-m",
        "rigmarket.checks",
        "harnesses",
        "{pack}/harnesses",
        "--expect",
        "32"
      ],
      "expect_stdout_contains": [
        "\"status\": \"PASS\""
      ]
    },
    {
      "id": "skills-wellformed",
      "description": "Every SKILL.md frontmatter name matches its directory and every run.py compiles.",
      "run": [
        "{python}",
        "-m",
        "rigmarket.checks",
        "skills",
        "{pack}/skills",
        "--expect",
        "23"
      ],
      "expect_stdout_contains": [
        "\"status\": \"PASS\""
      ]
    },
